 SG_ ELV_Lock : 8|1@1+ (1,0) [0|1] "" Vector__XXX
 SG_ Ignition_Suppress : 9|1@1+ (1,0) [0|1] "" Vector__XXX

BO_ 987 Gateway_72: 8 Vector__XXX
 SG_ BCM_Status_Alt : 0|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Lock_Status_Alt : 8|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Wiper_Status_Alt : 16|8@1+ (1,0) [0|255] "" Vector__XXX

BO_ 988 Gateway_73: 8 Vector__XXX
 SG_ Transmission_Status : 0|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ EPB_Status : 8|8@1+ (1,0) [0|255] "" Vector__XXX

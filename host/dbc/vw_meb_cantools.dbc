# VW MEB CAN IDs from docs/meb_can_ids.md
# Sources: opendbc (MIT), spot2000 CSV, DCDC-Hacking logs, SSP 747
# Confidence: ✅ ЛОГ = real capture, 📘 DBC = opendbc, 📋 CSV = spot2000, ❓ UNKNOWN = seen but undecoded

# ============================================================
# Battery (BMS) - Broadcast Messages
# ============================================================

BO_ 1442 BMS_04: 8 Vector__XXX
 SG_ BMS_Mode : 0|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ BMS_Error : 8|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ BMS_Shutdown : 16|1@1+ (1,0) [0|1] "" Vector__XXX
 SG_ BMS_Capacity : 24|16@1+ (0.1,0) [0|6553.5] "Ah" Vector__XXX

BO_ 1452 HVEM_02: 8 Vector__XXX
 SG_ HV_Consumer_Current : 0|16@1+ (0.1,0) [0|6553.5] "A" Vector__XXX
 SG_ HV_Useful_Energy : 16|32@1+ (1,0) [0|4294967295] "Wh" Vector__XXX

BO_ 247 MEB_HVEM_02: 8 Vector__XXX
 SG_ CNT : 0|8@1+ (1,0) [0|255] "" Vector__XXX

BO_ 1283 HVK_01: 8 Vector__XXX
 SG_ Target_BMS_Mode : 0|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Target_DCDC_Mode : 8|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Target_Compressor_Mode : 16|8@1+ (1,0) [0|255] "" Vector__XXX

BO_ 380225246 Battery_Temperatures: 8 Vector__XXX
 SG_ Max_Cell_Temp : 0|16@1+ (0.1,-40) [-40|6513.5] "degC" Vector__XXX
 SG_ Min_Cell_Temp : 16|16@1+ (0.1,-40) [-40|6513.5] "degC" Vector__XXX

BO_ 315370706 Battery_Heating_Status: 8 Vector__XXX
 SG_ Heating_Active : 0|1@1+ (1,0) [0|1] "" Vector__XXX
 SG_ Requested_Heating_Power : 8|16@1+ (10,0) [0|655350] "W" Vector__XXX
 SG_ Actual_Heating_Power : 24|16@1+ (10,0) [0|655350] "W" Vector__XXX

BO_ 190 MEB_HVEM_01: 48 Vector__XXX
 SG_ Motor_Speed : 0|16@1+ (1,0) [0|65535] "rpm" Vector__XXX
 SG_ Motor_Power : 16|16@1+ (100,0) [0|6553500] "W" Vector__XXX

# ============================================================
# Battery UDS - Request/Response (29-bit Extended)
# ============================================================

BO_ 402253691 Battery_UDS_Request: 8 Vector__XXX
# CAN ID 0x17FC007B - Request to Battery (BMS)
# UDS 0x22 ReadDataByIdentifier for 142 parameters

BO_ 402253755 Battery_UDS_Response: 8 Vector__XXX
# CAN ID 0x17FE007B - Response from Battery (BMS)

# ============================================================
# Thermal / Climate - Broadcast (11-bit Standard)
# ============================================================

BO_ 949 Klima_11: 8 Vector__XXX
 SG_ AC_Status : 0|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Compressor_Speed : 8|16@1+ (10,0) [0|655350] "rpm" Vector__XXX
 SG_ AC_Warnings : 24|8@1+ (1,0) [0|255] "" Vector__XXX

BO_ 1640 Klima_12: 8 Vector__XXX
 SG_ Seat_Heating_Buttons : 0|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Aux_Heater_Enable : 8|1@1+ (1,0) [0|1] "" Vector__XXX
 SG_ Defog_Status : 9|1@1+ (1,0) [0|1] "" Vector__XXX

BO_ 1505 Klima_Sensor_02: 8 Vector__XXX
 SG_ Outside_Temp : 0|16@1+ (0.1,-40) [-40|6513.5] "degC" Vector__XXX
 SG_ Heater_Valve_Status : 16|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Coolant_Pump_Status : 24|8@1+ (1,0) [0|255] "" Vector__XXX
 SG_ Compressor_Clutch : 32|1@1+ (1,0) [0|1] "" Vector__XXX

BO_ 1513 Klima_Sensor_04: 8 Vector__XXX
 SG_ Refrigerant_Pressure : 0|16@1+ (10,0) [0|655350] "Pa" Vector__XXX
 SG_ Ionizer_Status : 16|8@1+ (1,0) [0|255] "" Vector__XXX

# Thermal UDS (11-bit, DIFFERENT from Battery!)
BO_ 1862 Climate_UDS_Request: 8 Vector__XXX
# CAN ID 0x746 - Request to Climate

BO_ 1968 Climate_UDS_Response: 8 Vector__XXX
# CAN ID 0x7B0 - Response from Climate

# ============================================================
# Charging - Broadcast (29-bit Extended)
# ============================================================

BO_ 315370704 Charging_Dynamics: 8 Vector__XXX
 SG_ Max_Charge_Current : 0|16@1+ (0.1,0) [0|6553.5] "A" Vector__XXX
 SG_ Max_Charge_Power : 16|16@1+ (100,0) [0|6553500] "W" Vector__XXX

BO_ 442159538 Charging_Optimization: 8 Vector__XXX
 SG_ Charge_Temp_Status : 0|8@1+ (1,0) [0|255] "" Vector__XXX

